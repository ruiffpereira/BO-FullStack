{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(pnpm exec tsc --noEmit)",
      "Bash(pnpm exec eslint *)",
      "Bash(docker inspect *)",
      "Bash(curl -s https://api.rufvision.com/api/*)",
      "Bash(curl -sI https://*)",
      "Read(//d/Projetos/Projectos/API-FullStack/**)",
      "Read(//d/Projetos/Projectos/gymnoprado/**)",
      "Edit(//d/Projetos/Projectos/API-FullStack/**)",
      "Edit(//d/Projetos/Projectos/gymnoprado/**)",
      "Write(//d/Projetos/Projectos/API-FullStack/**)",
      "Write(//d/Projetos/Projectos/gymnoprado/**)"
    ],
    "additionalDirectories": [
      "d:ProjetosProjectosAPI-FullStack",
      "d:ProjetosProjectosgymnoprado"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Projetos/Projectos/.claude/hooks/guard.mjs\" pre-edit",
            "timeout": 10,
            "statusMessage": "Guarda: código gerado"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Projetos/Projectos/.claude/hooks/guard.mjs\" pre-bash",
            "timeout": 15,
            "statusMessage": "Guarda: trinco, migrações, git perigoso, cadeia cross-repo"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Projetos/Projectos/.claude/hooks/guard.mjs\" post-edit",
            "timeout": 15,
            "statusMessage": "Guarda: regras da plataforma"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Projetos/Projectos/.claude/hooks/guard.mjs\" session-start",
            "timeout": 10,
            "statusMessage": "A ler a fila de trabalho"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/Projetos/Projectos/.claude/hooks/guard.mjs\" session-end",
            "timeout": 10,
            "statusMessage": "A libertar o trinco"
          }
        ]
      }
    ]
  }
}
